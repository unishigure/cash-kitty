# Production build overrides (loaded by `bun run build`, NODE_ENV=production).
# Committed on purpose — contains no secrets. Values here override `.env`.

# Same-origin deploy: web at `<host>/` and the OCR API at `<host>/api`. An empty
# base makes the SPA call `/api/ocr/analyze` on its own origin, so the gateway
# routes it to the API — no CORS, no mixed content, works from phones too.
# (Local dev uses the value in `.env`, e.g. http://localhost:8000.)
BUN_PUBLIC_OCR_API_URL=
