# Money Note web server config (loaded automatically by Bun).
# Copy this file to `.env` and fill in your values.

# Google OAuth 2.0 Web client id (Google Cloud Console).
GOOGLE_CLIENT_ID=

# OCR API upstream (server-side only). The web server proxies /api/ocr/* here,
# so the browser always uses the same origin (works over HTTPS, no CORS).
OCR_API_URL=http://localhost:8000

# Web server port (optional, default 3000).
# PORT=3000
