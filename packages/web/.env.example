# Cash Kitty web config (loaded automatically by Bun).
# Copy this file to `.env` and fill in your values.
#
# These BUN_PUBLIC_* values are inlined into the bundle by both the dev server
# (`bun dev`) and the static build (`bun run build`). The Google client id is a
# public OAuth value, so baking it in is fine.

# Google OAuth web client id (Drive sync).
BUN_PUBLIC_GOOGLE_CLIENT_ID=

# OCR API base URL the SPA calls directly. In local dev the web (:3000) and API
# (:8000) are different origins, so point this at the API:
BUN_PUBLIC_OCR_API_URL=http://localhost:8000
# The production build serves web and API on one origin (`<host>/` + `<host>/api`),
# so `.env.production` overrides this to empty (same-origin). OCR then works only
# while `<host>/api` is reachable (i.e. your local API / tunnel is up).

# Web server port for `bun dev` (optional, default 3000).
# PORT=3000
