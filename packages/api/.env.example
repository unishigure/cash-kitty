# cash-kitty-api config (loaded automatically from packages/api/.env).
# Copy this file to `.env` and fill in your values. Real environment variables
# (e.g. set by the host) always take precedence over values in this file.

# Comma-separated list of allowed CORS origins (the SPA origin(s) that call this
# API cross-origin). Defaults to http://localhost:3000 when unset.
# In production, set this to your fixed HTTPS origin only — do NOT use "*".
#   CORS_ALLOW_ORIGINS=https://cashkitty.example.com
# Multiple origins are comma-separated:
#   CORS_ALLOW_ORIGINS=https://cashkitty.example.com,http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# OCR compute device: "cuda" (GPU) or "cpu".
# OCR_DEVICE=cuda

# Max accepted upload size in bytes (default 10 MiB).
# MAX_UPLOAD_SIZE_BYTES=10485760

# APP_NAME=cash-kitty-api
# APP_VERSION=0.1.0
